{
  "appId": "com.factorflux.app",
  "productName": "FactorFlux",
  "copyright": "Copyright © 2025 Trucking Pros Financial",
  "directories": {
    "output": "electron-dist"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "uploads/**/*",
    "!node_modules/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.business",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ]
  },
  "dmg": {
    "title": "FactorFlux ${version}",
    "artifactName": "FactorFlux-Mac-${version}.dmg"
  },
  "win": {
    "target": "nsis",
    "icon": "electron/assets/icon.ico"
  },
  "linux": {
    "target": "AppImage",
    "category": "Office"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}